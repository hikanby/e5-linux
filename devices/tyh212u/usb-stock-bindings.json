    "source_sha256": {
      "drivers/extcon/extcon-usb-gpio.c": "7098f3d604a683f95997e4499704790be5237bfd345c415665e69f7c1b51e31d",
      "drivers/gpio/gpio-pmic-eic-sprd.c": "11a9475d9a632629a81d6c6a6216c4e92cbd9aed576bbfda0ca2ed5b0f089f62",
