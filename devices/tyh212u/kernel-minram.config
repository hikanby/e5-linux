# Compile-only minimal RAM diagnostic seed for the pinned TYH212U kernel.
# No board DTB, embedded initramfs, command-line policy or boot container.
# Kconfig resolution and compilation do not validate hardware behavior.
CONFIG_LOCALVERSION="-tyh212u-minram"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_64BIT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HOTPLUG_CPU=n
CONFIG_ARCH_SPRD=y
CONFIG_EXPERT=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_OF=y
CONFIG_OF_RESERVED_MEM=y

# Static AArch64 BusyBox, script init and RAM-backed diagnostic filesystems.
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Ramoops needs a reviewed board reserved-memory node at runtime.
# PMSG is compiled, but the current /init does not write /dev/pmsg0.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_BLK=n

# UART and its actual SoC providers; GPIO/PMIC drivers are separate.
CONFIG_TTY=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_COMMON_CLK=y
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9620_CLK=y
CONFIG_RESET_CONTROLLER=y
CONFIG_REGMAP_MMIO=y
CONFIG_MFD_SYSCON=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SPRD=y
CONFIG_PINCTRL_SPRD_QOGIRN6PRO=y

# No module cohort or storage driver probes in this variant.
CONFIG_MODULES=n
CONFIG_MODULE_UNLOAD=n
CONFIG_BLOCK=n
CONFIG_BLK_DEV=n
CONFIG_BLK_DEV_RAM=n
CONFIG_SCSI=n
CONFIG_BLK_DEV_SD=n
CONFIG_SCSI_UFSHCD=n
CONFIG_SCSI_UFSHCD_PLATFORM=n
CONFIG_SCSI_UFS_SPRD_QOGIRN6PRO=n
CONFIG_MMC=n
CONFIG_MTD=n
CONFIG_ATA=n
CONFIG_NVMEM=n
CONFIG_NVMEM_SPRD_EFUSE=n

# No networking, USB, gadget, connector or PHY probes.
CONFIG_NET=n
CONFIG_UNIX=n
CONFIG_INET=n
CONFIG_PACKET=n
CONFIG_NETDEVICES=n
CONFIG_NET_CORE=n
CONFIG_TUN=n
CONFIG_VETH=n
CONFIG_BRIDGE=n
CONFIG_USB_SUPPORT=n
CONFIG_USB=n
CONFIG_USB_GADGET=n
CONFIG_USB_DWC3=n
CONFIG_USB_DWC3_OF_SIMPLE=n
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_XHCI_PLATFORM=n
CONFIG_USB_PHY=n
CONFIG_USB_SPRD_UMS9620_SSPHY=n
CONFIG_USB_CONFIGFS=n
CONFIG_USB_ROLE_SWITCH=n
CONFIG_GENERIC_PHY=n
CONFIG_EXTCON=n
CONFIG_EXTCON_USB_GPIO=n
CONFIG_TYPEC=n

# No vendor PMIC bus, software rail control, GPIO or DMA engine probes.
CONFIG_SPI=n
CONFIG_SPI_SPRD_ADI=n
CONFIG_I2C=n
CONFIG_HWSPINLOCK=n
CONFIG_HWSPINLOCK_SPRD=n
CONFIG_MFD_SC27XX_PMIC=n
CONFIG_REGULATOR=n
CONFIG_REGULATOR_UMP9620=n
CONFIG_REGULATOR_UMP9621=n
CONFIG_GPIOLIB=n
CONFIG_GPIO_EIC_SPRD=n
CONFIG_GPIO_SPRD=n
CONFIG_GPIO_PMIC_EIC_SPRD=n
CONFIG_DMADEVICES=n

# Do not add suspend, idle, frequency or IPA-domain policy to this probe set.
# ARM64 still selects generic POWER_RESET/POWER_SUPPLY frameworks.
CONFIG_PM=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n
CONFIG_SPRD_UMS9620_IPA_PD=n
CONFIG_WATCHDOG=n
CONFIG_RTC_CLASS=n

# No display, input, audio, radio, thermal, sensor or auxiliary CPU drivers.
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_REMOTEPROC=n
CONFIG_RPMSG=n
CONFIG_STAGING=n
CONFIG_THERMAL=n
CONFIG_HWMON=n
CONFIG_IIO=n
CONFIG_PWM=n
CONFIG_LEDS_CLASS=n
CONFIG_PCI=n
