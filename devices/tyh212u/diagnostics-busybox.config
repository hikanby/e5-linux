# Minimal seed read by BusyBox 1.37.0 allnoconfig via KCONFIG_ALLCONFIG.
# Nothing here initializes phone hardware. Mount has explicit -o flags but no
# fstab, helper, label/UUID, CIFS/NFS or mtab support.
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_CROSS_COMPILER_PREFIX="aarch64-linux-gnu-"
CONFIG_EXTRA_CFLAGS="-fno-pie"
CONFIG_EXTRA_LDFLAGS="-no-pie"
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_INSTALL_NO_USR=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_CAT=y
CONFIG_PRINTF=y
CONFIG_READLINK=y
CONFIG_SLEEP=y
CONFIG_UNAME=y
CONFIG_TEST1=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
# CONFIG_PIE is not set
# CONFIG_BUILD_LIBBUSYBOX is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_FEATURE_SUID is not set
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_FEATURE_SH_NOFORK is not set
# CONFIG_FEATURE_PREFER_APPLETS is not set
# CONFIG_FEATURE_SH_EMBEDDED_SCRIPTS is not set
# CONFIG_ASH_JOB_CONTROL is not set
# CONFIG_ASH_BASH_COMPAT is not set
# CONFIG_TEST is not set
# CONFIG_TEST2 is not set
# CONFIG_FEATURE_MOUNT_FSTAB is not set
# CONFIG_FEATURE_MOUNT_OTHERTAB is not set
# CONFIG_FEATURE_MOUNT_HELPERS is not set
# CONFIG_FEATURE_MOUNT_LABEL is not set
# CONFIG_FEATURE_MOUNT_CIFS is not set
# CONFIG_FEATURE_MOUNT_NFS is not set
# CONFIG_FEATURE_MOUNT_FAKE is not set
# CONFIG_FEATURE_MTAB_SUPPORT is not set
